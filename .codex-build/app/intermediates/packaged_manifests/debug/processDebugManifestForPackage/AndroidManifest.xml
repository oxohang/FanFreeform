<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.oxohang.fanfreeform"
    android:versionCode="136"
    android:versionName="1.0-debug" >

    <uses-sdk
        android:minSdkVersion="30"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="com.android.systemui" />
        <package android:name="com.miui.home" />
        <package android:name="org.lsposed.manager" />

        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme" >
        <activity
            android:name="com.oxohang.fanfreeform.debug.DebugHookReloadActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.AppPickerActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.TargetManagerActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.GestureSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.GestureDetailSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.AnimationSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.FanLayoutSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.HoneycombSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.HoneycombLayoutEditorActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.HoneycombAnimationSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.TaskCenterSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.TaskCenterAnimationSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.GeneralSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.WindowSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.OutsideSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.MiscSettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.PressureCalibrationActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.MainActivity"
            android:exported="false" />
        <activity
            android:name="com.oxohang.fanfreeform.ui.DashboardActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="settings"
                    android:scheme="hypergesture" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="com.oxohang.fanfreeform.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="com.oxohang.fanfreeform.ui.DashboardActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="com.oxohang.fanfreeform.config.ConfigProvider"
            android:authorities="com.oxohang.fanfreeform.config"
            android:exported="true"
            android:grantUriPermissions="false" />
        <provider
            android:name="com.oxohang.fanfreeform.diagnostics.CompatibilityReportProvider"
            android:authorities="com.oxohang.fanfreeform.reports"
            android:exported="false"
            android:grantUriPermissions="true" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="HyperOS 3 底角扇形快捷小窗" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.oxohang.fanfreeform.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
    </application>

</manifest>